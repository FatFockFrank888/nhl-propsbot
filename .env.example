# Copy to .env and adjust. All values are optional.

# --- Secrets (on GitHub: Settings -> Secrets and variables -> Actions) --------
# The Odds API key (https://the-odds-api.com).
ODDS_API_KEY=
# Your private ntfy channel name (phone notifications).
NTFY_TOPIC=
# Pinnacle guest API key (sharp reference; requires "use_pinnacle": true in settings.json).
PINNACLE_API_KEY=

# --- Odds ---------------------------------------------------------------

# Books you place bets at. Picks are only produced for these.
BET_BOOKS=unibet,atg,svenskaspel
# Odds API keys for the books above (region "se").
ODDS_API_BET_BOOKS=unibet_se,atg_se,svenskaspel_se
# Books used only as a de-vigged market reference (they carry NHL player props).
ODDS_API_REFERENCE_BOOKS=draftkings,fanduel,betmgm,williamhill_us
ODDS_API_MARKETS=player_shots_on_goal
# Folder for manual odds files (odds/YYYY-MM-DD.csv)
ODDS_DIR=odds

# --- Bankroll & bet selection ----------------------------------------------
BANKROLL=1000
CURRENCY=SEK
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.02
MIN_EDGE=0.03
MIN_EV=0.03
MIN_GAMES=8
MIN_ODDS=1.40
MAX_ODDS=5.00

# --- Model (tune with `python -m propsbot backtest`) -----------------------
DISPERSION=0.05
LOOKBACK_GAMES=25
RATE_HALF_LIFE=10
TOI_LOOKBACK_GAMES=10
TOI_HALF_LIFE=4
PRIOR_MINUTES=40
HOME_EDGE=0.02
